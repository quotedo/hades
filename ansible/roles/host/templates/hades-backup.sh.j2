#!/bin/bash
# {{ ansible_managed }}
# Nightly insurance against an accidental rm: per member of group
# {{ hades_group }}, the ADE state and agent logins go into
# {{ backup_dir }}/<user>-<date>.tar.gz; the newest {{ host_backup_keep }} per user are kept.
# Dev data itself is reproducible and is not backed up.
set -euo pipefail
umask 077

backup_dir={{ backup_dir | quote }}
keep={{ host_backup_keep | int }}
paths=(.paseo .config/orca .orca .claude .codex .config/gh)
today=$(date +%F)
status=0

mkdir -p "$backup_dir"
chmod 0700 "$backup_dir"

members=$(getent group {{ hades_group | quote }} | cut -d: -f4 | tr ',' ' ')

for user in $members; do
  home=$(getent passwd "$user" | cut -d: -f6) || home=
  if [ -z "$home" ] || [ ! -d "$home" ]; then
    echo "hades-backup: $user: no home directory, skipped" >&2
    continue
  fi

  present=()
  found=0
  for p in "${paths[@]}"; do
    if [ -e "$home/$p" ]; then
      present+=("$p")
      found=$((found + 1))
    fi
  done
  if [ "$found" -eq 0 ]; then
    echo "hades-backup: $user: nothing to back up"
    continue
  fi

  # Leftovers of an interrupted run; the prune below never matches them.
  find "$backup_dir" -maxdepth 1 -type f \
    -name "$user-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].tar.gz.tmp" -delete

  out="$backup_dir/$user-$today.tar.gz"
  # tar runs as the user, so a symlinked directory in their home cannot pull in files only root
  # may read; root writes the stream into the root-only backup directory. GNU tar exits 1 when a
  # file changed while it was read; the archive is still usable.
  rc=0
  runuser -u "$user" -- tar --create --gzip --file - --directory "$home" \
    --warning=no-file-changed --exclude='.paseo/*.log' -- "${present[@]}" >"$out.tmp" || rc=$?
  if [ "$rc" -gt 1 ]; then
    echo "hades-backup: $user: tar failed with exit $rc" >&2
    rm -f -- "$out.tmp"
    status=1
    continue
  fi
  mv -f -- "$out.tmp" "$out"
  echo "hades-backup: $user: wrote $out"

  # Only the nightly archives of this user; offboarding archives (<user>-offboard-*) stay.
  find "$backup_dir" -maxdepth 1 -type f \
    -name "$user-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].tar.gz" -printf '%f\n' |
    sort -r | tail -n +"$((keep + 1))" |
    while IFS= read -r old; do
      rm -f -- "$backup_dir/$old"
    done
done

exit "$status"
