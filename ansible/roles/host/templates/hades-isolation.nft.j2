#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Loopback isolation. This file manages table inet hades and nothing else;
# hades-nftables.service applies it at boot and on reload. Do not include it from
# /etc/nftables.conf. The first two lines make the reload atomic and idempotent.
table inet hades {}
delete table inet hades

table inet hades {
	# root, the present dev users and the service accounts that exist on this host
	set allowed_uids {
		type uid
		elements = { {{ ([0] + host_isolation_dev_uids + host_isolation_service_uids) | unique | sort | join(', ') }} }
	}

	# the present dev users
	set dev_uids {
		type uid
{% if host_isolation_dev_uids | length > 0 %}
		elements = { {{ host_isolation_dev_uids | join(', ') }} }
{% endif %}
	}

	# worktree ports, dev Postgres, shared services, Caddy and every ADE daemon port
	set dev_ports {
		type inet_service
		flags interval
		auto-merge
		elements = { {{ host_isolation_dev_ports | join(', ') }} }
	}

	# the Orca servers' ports; Orca binds every address and has no option to narrow it
	set orca_ports {
		type inet_service
{% if host_isolation_orca_ports | length > 0 %}
		elements = { {{ host_isolation_orca_ports | join(', ') }} }
{% endif %}
	}

	# protected workloads the dev users must not reach (protected.blocked_ports)
	set blocked_ports {
		type inet_service
		flags interval
		auto-merge
{% if host_isolation_blocked_ports | length > 0 %}
		elements = { {{ host_isolation_blocked_ports | join(', ') }} }
{% endif %}
	}

	# Connection attempts only (SYN without ACK), and only to an address of this host
	# (loopback, bridges and public addresses alike), so outbound traffic to other hosts and
	# replies on established connections are never touched. Priority mangle (-150) runs before
	# nat output (-100), so a DNAT to a container cannot hide the local destination.
	chain output {
		type filter hook output priority mangle; policy accept;
		tcp flags & (fin | syn | rst | ack) == syn tcp dport @dev_ports meta skuid != @allowed_uids fib daddr type local counter reject with tcp reset
		tcp flags & (fin | syn | rst | ack) == syn tcp dport @blocked_ports meta skuid @dev_uids fib daddr type local counter reject with tcp reset
	}

	# Orca is reachable over loopback and Tailscale only, whatever else the host firewall allows.
	chain input {
		type filter hook input priority filter; policy accept;
		tcp flags & (fin | syn | rst | ack) == syn tcp dport @orca_ports iifname != { "lo", "tailscale0" } counter reject with tcp reset
	}
}
