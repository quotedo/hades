#!/bin/sh
# {{ ansible_managed }}
# hades-keys [LOGIN]: write the jump account's authorized_keys and, inside each developer's VM, the
# developer's own. The list holds `login:github:address` lines; a developer's keys are their static
# keys, then their GitHub keys (none for an empty login). In the jump file each key may only open a
# tunnel to the developer's VM's SSH, and a session prints `<login>@<address>`. A key already
# written for an earlier login is left out of both files. A failed fetch keeps the developer's jump
# lines and VM file; an empty one is an empty set of GitHub keys. With LOGIN, the other developers'
# jump lines are kept as they are. The VM file is written as the developer, so a link in their home
# reaches nothing they could not write.
set -u
[ $# -le 1 ] || { echo "usage: hades-keys [LOGIN]" >&2; exit 2; }
want=${1:-}
list=${HADES_KEYS_FILE:-{{ hades_config_dir }}/github-logins}
jump=/var/lib/hades-jump/.ssh/authorized_keys
[ -f "$list" ] || exit 0
# One run at a time: the VMs' applies call it side by side, and the timer may too.
exec 9> /run/hades-keys.lock
flock -w 600 9 || { echo "locked, skipped"; exit 0; }

out= seen=
while IFS=: read -r login github address; do
  case $login in '' | '#'*) continue ;; esac
  # This developer's keys in the jump file, without the options (which hold one space).
  keys=$(grep -sF "permitopen=\"$address:22\"" "$jump" | cut -d' ' -f3-) vm=
  if [ -z "$want" ] || [ "$login" = "$want" ]; then
    gh=
    if [ -n "$github" ] && ! gh=$(curl -fsSL --max-time 20 "https://github.com/$github.keys"); then
      echo "$login: fetch failed, kept"
    else
      keys=$(cat "{{ hades_config_dir }}/ssh-keys/$login" 2>/dev/null; [ -z "$gh" ] || printf '%s\n' "$gh") vm=1
    fi
  fi
  mine=
  while read -r type blob comment; do
    case $type in '' | '#'*) continue ;; esac
    other=$(printf '%s' "$seen" | awk -v b="$blob" '$1 == b { print $2; exit }')
    if [ -n "$other" ]; then
      [ "$other" = "$login" ] || echo "$login: key $type ${comment:+$comment }also belongs to $other, skipped"
      continue
    fi
    key="$type $blob${comment:+ $comment}"
    seen="$seen$blob $login
"
    mine="$mine$key
"
    out="${out}restrict,port-forwarding,permitopen=\"$address:22\",command=\"echo $login@$address\" $key
"
  done <<EOF
$keys
EOF
  [ -n "$vm" ] || continue
  if ! incus exec "$login" -- id -u "$login" < /dev/null > /dev/null 2>&1; then
    echo "$login: no account yet, skipped"
    continue
  fi
  result=$(printf '%s' "$mine" | incus exec "$login" -- runuser -u "$login" -- sh -c '
    umask 077; new=$(cat); f=$HOME/.ssh/authorized_keys
    [ -f "$f" ] && [ "$(cat "$f")" = "$new" ] && { echo unchanged; exit 0; }
    mkdir -p "$HOME/.ssh" && printf "%s\n" "$new" > "$f.new" && mv -f "$f.new" "$f" && echo updated
  ') || result="write failed, kept"
  echo "$login: $result"
done < "$list"

umask 022
printf '%s' "$out" > "$jump.new"
if cmp -s "$jump.new" "$jump"; then
  rm -f "$jump.new"
  echo "jump file: unchanged"
else
  mv -f "$jump.new" "$jump" && echo "jump file: updated"
fi
exit 0
