#!/bin/sh
# {{ ansible_managed }}
# hades-onboard [ALIAS]: a developer's first-login steps in their VM; ALIAS, the name their laptop
# reaches the VM by, only appears in the Paseo Desktop address. Safe to run again: each step says
# "already done" or does its work. hades doctor decides whether onboarding is complete; every
# complete run prints the connection details.
set -u
[ -t 0 ] || { echo "hades-onboard needs a terminal: ssh -t <alias> hades-onboard <alias>" >&2; exit 2; }
host=${1:-$(hostname)}
dir=$HOME/.config/hades

command -v gh >/dev/null 2>&1 || { echo "gh: not installed; the administrator adds gh to tools"; exit 1; }
if gh auth status >/dev/null 2>&1; then echo "gh: already done"; else gh auth login -h github.com -p https -w; fi
case $(git config --global credential.https://github.com.helper) in
*gh*) echo "git: already done" ;;
*) gh auth setup-git && echo "git: credentials through gh" ;;
esac

if command -v claude >/dev/null 2>&1; then
  if claude auth status >/dev/null 2>&1; then echo "claude: already done"; else claude auth login; fi
fi
if command -v codex >/dev/null 2>&1; then
  if codex login status >/dev/null 2>&1; then echo "codex: already done"; else codex login --device-auth; fi
fi

failed=
if [ -f "$dir/repos" ]; then
  while read -r url; do
    [ -n "$url" ] || continue
    name=$(basename "$url" .git)
    if [ -d "$HOME/$name" ]; then
      echo "clone $name: already done"
    else
      git clone "$url" "$HOME/$name" </dev/null || failed="$failed $name"
    fi
  done < "$dir/repos"
fi
if [ -n "$failed" ]; then
  echo "onboarding incomplete: clone$failed failed; run hades-onboard again"
  exit 1
fi

# The developer's tailnet carries Paseo on the phone and Orca. tailscale up prints the login link
# and waits for it. Orca pairs on the tailnet address, so it starts again once there is one.
tailnet() { tailscale status --json 2>/dev/null | jq -r "$1"; }
if [ "$(tailnet .BackendState)" = Running ]; then
  echo "tailscale: already done"
elif ! sudo tailscale up --hostname={{ inventory_hostname }}; then
  echo "onboarding incomplete: tailscale up failed; run hades-onboard again"
  exit 1
fi
since=$(date '+%Y-%m-%d %H:%M:%S')
if systemctl --user cat orca.service >/dev/null 2>&1; then
  systemctl --user reset-failed orca.service; systemctl --user restart orca.service
fi

if ! {{ hades_bin_dir }}/hades doctor; then
  echo "onboarding incomplete: fix the FAIL lines above and run hades-onboard again"
  exit 1
fi
mkdir -p "$dir" && touch "$dir/onboarded"
echo "onboarding complete"

ts=$(tailnet '.Self.DNSName | rtrimstr(".")')
if systemctl --user cat paseo.service >/dev/null 2>&1; then
  echo "Paseo Desktop: Settings > Add host > Remote SSH"
  echo "  ssh://$(id -un)@$host"
  echo "  Daemon password: $(sed -n 's/^PASEO_PASSWORD=//p' "$dir/paseo.env")"
  # Paseo answers 403 to a Host name it was not given, and accepts any address.
  echo "Paseo on your phone (Tailscale on): $(tailscale ip -4):6767, same password"
fi
# Orca prints its pairing URL once it is up.
if systemctl --user cat orca.service >/dev/null 2>&1; then
  for _ in $(seq 60); do
    url=$(journalctl --user -u orca.service --since "$since" -o cat | sed -n 's/^Pairing URL: //p' | tail -1)
    [ -z "$url" ] || break
    sleep 1
  done
  echo "Orca pairing: ${url:-not printed yet, see journalctl --user -u orca.service}"
fi
echo "Tailscale: disable key expiry for $ts in your Tailscale admin console, or it leaves your tailnet after 180 days."
