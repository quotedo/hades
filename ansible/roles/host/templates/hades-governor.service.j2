# {{ ansible_managed }}
[Unit]
Description=Set every CPU's frequency governor to {{ cpu_governor }}
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo {{ cpu_governor }} > "$$g"; done'

[Install]
WantedBy=multi-user.target
