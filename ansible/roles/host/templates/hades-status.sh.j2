#!/bin/bash
# {{ ansible_managed }}
# hades-status: "why did my test die" and "who is filling the disk" (design 6.10).
# Read-only. Every section prints, and reports "unavailable" when it cannot be read.
set -uo pipefail
export LC_ALL=C

hades={{ (hades_bin_dir ~ '/hades') | quote }}
group={{ hades_group | quote }}
pg_host={{ dev_pg_host | quote }}
pg_port={{ dev_pg_port | int }}
pg_user={{ dev_pg_user | quote }}
pg_password={{ dev_pg_password | quote }}

is_root() { [ "$(id -u)" -eq 0 ]; }
members=$(getent group "$group" | cut -d: -f4 | tr ',' ' ')

# memory and CPU pressure ("some" avg10 / avg60) of one cgroup
pressure() {
  local dir="/sys/fs/cgroup/$2" mem cpu
  if [ ! -d "$dir" ]; then
    printf '  %-28s not running\n' "$1"
    return
  fi
  mem=$(awk '/^some/ { print $2 "/" $3 }' "$dir/memory.pressure" 2>/dev/null)
  cpu=$(awk '/^some/ { print $2 "/" $3 }' "$dir/cpu.pressure" 2>/dev/null)
  printf '  %-28s memory %-26s cpu %s\n' "$1" "${mem:-unavailable}" "${cpu:-unavailable}"
}

echo "slices:"
pressure hades.slice hades.slice
pressure system.slice system.slice
pressure user.slice user.slice
for user in $members; do
  uid=$(id -u "$user" 2>/dev/null) || continue
  pressure "$user (user-$uid.slice)" "user.slice/user-$uid.slice"
done
echo
if cgtop=$(systemd-cgtop -b -n1 -m --depth=2 2>/dev/null); then
  echo "  by memory (systemd-cgtop): control group, tasks, %cpu, memory, input/s, output/s"
  head -n 16 <<<"$cgtop" | sed 's/^/  /'
else
  echo "  systemd-cgtop unavailable"
fi

echo
errfile=$(mktemp)
trap 'rm -f -- "$errfile"' EXIT
if list=$("$hades" ls --json 2>"$errfile") && count=$(jq length <<<"$list" 2>/dev/null); then
  echo "worktrees: $count"
  if [ "$count" -gt 0 ]; then
    jq -r 'group_by(.User)[] | "  \(.[0].User): \(length)"' <<<"$list"
    echo
    jq -r '.[] | [.Label, .User, (.Port | tostring), (if .Host == "" then "-" else "https://" + .Host end), .Worktree] | @tsv' <<<"$list" |
      awk -F '\t' '{ printf "  %-32s %-12s %-6s %-48s %s\n", $1, $2, $3, $4, $5 }'
  fi
else
  echo "worktrees: unavailable ($(head -n 1 "$errfile"))"
fi

echo
if ! command -v psql >/dev/null 2>&1; then
  echo "dev postgres connections: unavailable (psql is not installed)"
elif [ -z "$(ss -Hltn "sport = :$pg_port" 2>/dev/null)" ]; then
  echo "dev postgres connections: unavailable (nothing listens on port $pg_port)"
elif n=$(PGPASSWORD="$pg_password" PGCONNECT_TIMEOUT=3 psql -w -X -At -h "$pg_host" -p "$pg_port" \
  -U "$pg_user" -d postgres \
  -c "select count(*) from pg_stat_activity where backend_type = 'client backend' and pid <> pg_backend_pid()" 2>&1); then
  echo "dev postgres connections: $n"
else
  echo "dev postgres connections: unavailable ($(head -n 1 <<<"$n"))"
fi

echo
echo "oom kills (this boot, last 10):"
if ! is_root && ! id -nG | tr ' ' '\n' | grep -qxE 'adm|systemd-journal'; then
  echo "  unavailable (needs root or group adm)"
else
  kills=$(journalctl -k -q --no-pager -o short-iso 2>/dev/null | grep -E 'oom-kill:|Killed process' | tail -n 10)
  if [ -n "$kills" ]; then
    sed 's/^/  /' <<<"$kills"
  else
    echo "  none"
  fi
fi

echo
echo "disk:"
df -h / | sed 's/^/  /'
echo
if is_root; then
  echo "largest homes:"
else
  echo "largest homes (partial: unreadable directories are not counted without root):"
fi
getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $6 }' | sort -u |
  while IFS= read -r home; do
    [ -d "$home" ] && printf '%s\0' "$home"
  done |
  xargs -0 -r du -sxh 2>/dev/null | sort -rh | head -n 5 | sed 's/^/  /'

exit 0
