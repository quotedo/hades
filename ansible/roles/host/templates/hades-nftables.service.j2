# {{ ansible_managed }}
# Applies table inet hades only. Ordered after nftables.service, in case a host enables it, so
# that its `flush ruleset` cannot remove these rules.
[Unit]
Description=Hades loopback isolation rules (nftables table inet hades)
DefaultDependencies=no
Wants=network-pre.target
After=nftables.service
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/hades.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/hades.nft
ExecStop=/usr/sbin/nft delete table inet hades

[Install]
WantedBy=sysinit.target
