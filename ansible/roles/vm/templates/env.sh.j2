# {{ ansible_managed }}
# Sourced at the top of ~/.bashrc, before its interactive-only return, so login shells (through
# ~/.profile) and non-interactive ones get the toolchain too.
case ":$PATH:" in
*":{{ hades_bin_dir }}:"*) ;;
*) export PATH="{{ hades_bin_dir }}:{{ mise_shims }}:$HOME/.local/bin:$PATH" ;;
esac
export CHROME_PATH={{ (chrome_root ~ '/chrome') | quote }} ERL_FLAGS={{ erl_flags | quote }} DISABLE_AUTOUPDATER=1
# Non-interactive logins set no LANG, and Elixir then runs in latin1.
export LANG="${LANG:-C.UTF-8}"
# mise points both into the root-owned Elixir install unless they are set; Hex lives per user.
export MIX_HOME="$HOME/.mix" MIX_ARCHIVES="$HOME/.mix/archives"
# direnv's hook joins PROMPT_COMMAND; a later PROMPT_COMMAND= assignment in ~/.bashrc drops it.
# hades-onboard writes the marker once it completes.
case $- in
*i*)
  eval "$(direnv hook bash)"
  [ -f "$HOME/.config/hades/onboarded" ] || echo "Run hades-onboard to finish setting up your account."
  ;;
esac
