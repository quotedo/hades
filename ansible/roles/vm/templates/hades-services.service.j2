# {{ ansible_managed }}
# No ExecStop: a restart re-runs `up -d`, which recreates only the services whose config changed.
[Unit]
Description=hades dev services (compose project hades)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ services_dir }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans
Restart=on-failure

[Install]
WantedBy=multi-user.target
