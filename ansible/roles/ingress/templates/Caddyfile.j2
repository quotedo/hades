# {{ ansible_managed }}
# The Cloudflare tunnel terminates TLS, so Caddy serves plain HTTP on loopback only. Only the
# inventory changes this configuration, so there is no admin API.
{
	auto_https off
	admin off
	default_bind {{ hades_loopback_address }}
}

http://:{{ caddy_port }} {
	# The dev paths need the header Cloudflare Access adds. Developer names have no dash, so no
	# developer's matcher is this one or matches another developer's names.
	@gated-path {
		path /dev* /tidewave* /phoenix/live_reload*
		not header Cf-Access-Jwt-Assertion *
	}
{% for dev in dev_present %}
	@{{ dev.name }} header_regexp Host ^{{ dev.name }}-
{% endfor %}
	# In this order: the gate, each developer's names to their VM's Caddy, then a redirect to the
	# apex, so unknown names say nothing about this server.
	route {
		respond @gated-path 403
{% for dev in dev_present %}
		reverse_proxy @{{ dev.name }} {{ dev.address }}:{{ caddy_port }}
{% endfor %}
		redir https://{{ hades_domain }} 302
	}
}
