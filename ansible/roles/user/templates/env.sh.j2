# {{ ansible_managed }}
# Sourced at the top of ~/.bashrc, before its interactive-only return, so login shells (through
# ~/.profile) and non-interactive ones get the toolchain too. ERL_FLAGS and CHROME_PATH come
# from /etc/profile.d.
case ":$PATH:" in
*":$HOME/.asdf/shims:"*) ;;
*) export PATH="$HOME/.asdf/shims:$HOME/.asdf/bin:$HOME/.local/bin{% for path in hades_tool_paths %}:{{ path }}{% endfor %}:$PATH" ;;
esac
export KERL_CONFIGURE_OPTIONS={{ kerl_configure_options | quote }}
# direnv's hook joins PROMPT_COMMAND; a later PROMPT_COMMAND= assignment in ~/.bashrc drops it.
case $- in
*i*) eval "$(direnv hook bash)" ;;
esac
