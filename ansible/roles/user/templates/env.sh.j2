# {{ ansible_managed }}
# Sourced at the top of ~/.bashrc, before its interactive-only return, so login shells (through
# ~/.profile) and non-interactive ones get the toolchain too. ERL_FLAGS and CHROME_PATH come
# from /etc/profile.d.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:{{ mise_shims }}:$PATH" ;;
esac
# mise points both into the root-owned Elixir install unless they are set; Hex lives per user.
export MIX_HOME="$HOME/.mix" MIX_ARCHIVES="$HOME/.mix/archives"
# direnv's hook joins PROMPT_COMMAND; a later PROMPT_COMMAND= assignment in ~/.bashrc drops it.
# The welcome stays until hades-onboard completes.
case $- in
*i*)
  eval "$(direnv hook bash)"
  [ -f "$HOME/.config/hades/welcome" ] && . "$HOME/.config/hades/welcome"
  ;;
esac
