# {{ ansible_managed }}
# Read by paseo.service and ahead of ~/.paseo/config.json. The password was generated on this
# host; a value changed here is kept by later runs.
PASEO_PASSWORD={{ user_paseo_password.stdout_lines[-1] }}
PASEO_LISTEN={{ host_loopback_address }}:{{ user.paseo_port }}
PASEO_RELAY_ENABLED=false
