# {{ ansible_managed }}
[Unit]
Description={{ ade | capitalize }} for {{ user.name }}

[Service]
# User units do not read /etc/profile.d, so the login environment is repeated here.
Environment=PATH=%h/.local/bin:{{ mise_shims }}{% for path in hades_tool_paths %}:{{ path }}{% endfor %}:/usr/local/bin:/usr/bin:/bin
Environment="ERL_FLAGS={{ erl_flags }}" CHROME_PATH={{ chrome_root }}/chrome MIX_HOME=%h/.mix MIX_ARCHIVES=%h/.mix/archives
{% if ade == 'paseo' %}
Environment=PASEO_LISTEN={{ host_loopback_address }}:{{ user.paseo_port }} PASEO_RELAY_ENABLED=false
EnvironmentFile=%h/.config/hades/paseo.env
ExecStart={{ mise_shims }}/paseo daemon run
{% else %}
# orca-ide runs {{ user_orca_link.stat.lnk_target | default('') }}
Environment=ORCA_TERMINAL_MEMORY_MAX={{ orca_terminal_memory_max }} ORCA_TERMINAL_MEMORY_SWAP_MAX={{ orca_terminal_swap_max }}
ExecStart=/usr/local/bin/orca-ide serve --port {{ user.orca_port }} --pairing-address {{ user_tailscale_ip.stdout }}
{% endif %}
Restart=on-failure

[Install]
WantedBy=default.target
