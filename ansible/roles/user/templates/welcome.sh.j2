# {{ ansible_managed }}
# Sourced by env.sh in interactive shells until hades-onboard completes, which deletes it.
echo "Welcome to {{ inventory_hostname }}, {{ user.name }}."
{% if 'paseo' in user.ades | default([]) %}
echo "Paseo Desktop: Remote SSH, host {{ inventory_hostname }}, user {{ user.name }}, port {{ user.paseo_port }}"
(. "$HOME/.config/hades/paseo.env" && echo "Paseo password: $PASEO_PASSWORD")
{% endif %}
{% if 'orca' in user.ades | default([]) %}
echo "Orca pairing URL: journalctl --user -u orca.service"
{% endif %}
echo "Laptop: hades join {{ inventory_hostname }} --as {{ user.name }}"
echo "Next: run hades-onboard"
