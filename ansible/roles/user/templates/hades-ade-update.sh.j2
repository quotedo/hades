#!/bin/sh
# {{ ansible_managed }}
# Moves an ADE to another version and restarts it; later Ansible runs never downgrade it.
#   hades-ade-update paseo [version or npm dist-tag]   default: latest
#   hades-ade-update orca [version]                    default: the latest release
set -eu
export PATH="$HOME/.asdf/shims:$HOME/.asdf/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
version=${2:-latest}
case ${1:-} in
paseo)
  npm install -g "@getpaseo/cli@$version"
  asdf reshim nodejs
  ;;
orca)
  if [ "$version" = latest ]; then
    url={{ user_orca_releases_url }}/latest/download/orca-linux.AppImage
  else
    url={{ user_orca_releases_url }}/download/v$version/orca-linux.AppImage
  fi
  appimage=$HOME/.local/opt/orca/orca.AppImage
  curl -fL -o "$appimage.new" "$url"
  chmod 0755 "$appimage.new"
  mv "$appimage.new" "$appimage"
  ;;
*)
  echo "usage: hades-ade-update paseo|orca [version]" >&2
  exit 2
  ;;
esac
systemctl --user restart "$1.service"
