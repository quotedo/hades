# Secrets come only from the administrator's environment; never commit a filled-in .env.
# Token: Account Cloudflare Tunnel Edit, Access: Apps and Policies Edit, Access: Organizations Edit; Zone DNS Edit
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Private Hex repositories: one key and fingerprint pair per hex_repos entry, named by its key_env and fingerprint_env.
HEX_REPO_KEY=
HEX_REPO_FINGERPRINT=
# One per box with vpn_enabled, named by its vpn_conf_env: the Amnezia client's exported AmneziaWG
# config, AllowedIPs edited to the intranet subnets, no DNS line. Multi-line: export it from a file.
AMNEZIA_WG_CONF_BOX=
# verify.yml --tags jump: the path of a private key whose public key is in a present developer's ssh_keys.
HADES_TEST_KEY=
